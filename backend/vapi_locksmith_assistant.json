    "provider": "11labs",
    "voiceId": "aria",
    "settings": {
      "stability": 0.5,
      "similarityBoost": 0.75
    }
  },
  "model": {
    "provider": "openai",
    "model": "gpt-4",
    "temperature": 0.7
  },
