      "parameters": {
        "type": "object",
        "properties": {
          "customerName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "serviceType": {
            "enum": [
              "power_outage",
              "installation",
              "repair",
              "inspection",
              "emergency"
            ]
          },
          "urgency": {
            "enum": [
              "emergency",
              "same_day",
              "scheduled"
            ]
          },
          "propertyType": {
            "enum": [
              "residential",
              "commercial",
              "industrial"
            ]
          }
        },
        "required": [
          "customerName",
          "phone",
          "address",
          "serviceType",
          "urgency"
        ]
      }
    },
    {
      "name": "sendTextSummary",
      "description": "Send job details to electrician",
      "parameters": {
        "type": "object",
